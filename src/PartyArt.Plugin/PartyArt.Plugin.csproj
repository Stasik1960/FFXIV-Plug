<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.0</Version>
    <AssemblyName>PartyArt</AssemblyName>
    <RootNamespace>PartyArt.Plugin</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Author>Ringoto</Author>
    <CanUnloadAsync>true</CanUnloadAsync>
    <RepoUrl>https://github.com/Stasik1960/FFXIV-Plug</RepoUrl>
    <Name>Party Art</Name>
    <Punchline>Ваши фразы в нужный момент.</Punchline>
    <Description>Создавайте заготовки из нескольких сообщений и назначайте автоматические события: вход и завершение данжа, вайп, бой, смерть, воскрешение и изменения группы. Ручной запуск, каналы группы и альянса, локальная проверка, общая очередь с регулируемой паузой. Интерфейс с отключаемым фоном с волком. Автор Ringoto.</Description>
    <Tags>chat;party;social;art</Tags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PartyArt.Core/PartyArt.Core.csproj" />
    <Content Include="Assets/wolf.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
